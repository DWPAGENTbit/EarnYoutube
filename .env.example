# Salin ke .env.local lalu isi. File .env* (selain contoh ini) tidak ikut ke git.
# Semua nilai tanpa awalan NEXT_PUBLIC_ hanya dipakai di server/worker.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://wnyvkeodfuouoxnfsyao.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: hanya server & worker. JANGAN pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplikasi ---
# URL publik aplikasi (dipakai untuk redirect OAuth YouTube & link email).
APP_URL=http://localhost:3000
# Kunci AES-256-GCM untuk token OAuth & API key user (32 byte, base64). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan diganti setelah ada data: token lama tidak bisa didekripsi lagi.
TOKEN_ENCRYPTION_KEY=

# --- Google Cloud (OAuth client "Web application") ---
# Authorized redirect URI: ${APP_URL}/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI & media (cadangan; tiap user juga bisa mengisi sendiri di halaman Settings) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Worker ---
# Kosongkan untuk memakai ffmpeg-static / ffprobe-static bawaan.
FFMPEG_PATH=
FFPROBE_PATH=
# Nama worker (default: hostname), tahap yang dikerjakan (koma, kosong = semua),
# dan jeda polling antrean dalam milidetik.
WORKER_ID=
WORKER_STAGES=
WORKER_POLL_MS=5000
